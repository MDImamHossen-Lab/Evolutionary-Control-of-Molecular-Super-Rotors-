import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import odeint

# ==============================================================================
# SECTION 1: PHYSICAL CONSTANTS & SYSTEM CONFIGURATION
# ==============================================================================

# Simulation Parameters
HBAR = 1.0                # Normalized Planck constant
B_CONST = 1.0             # Rotational constant B for N2 (Normalized)
DELTA_ALPHA = 50.0        # Polarizability anisotropy (Interaction strength)
J_MAX = 20                # Basis set truncation (J = 0, 2, ... 2*J_MAX)
TIME_MAX = 15.0           # Simulation duration (a.u.)
STEPS = 1000              # Time resolution

# ==============================================================================
# SECTION 2: THE QUANTUM PHYSICS ENGINE (VIRTUAL LAB)
# ==============================================================================

def build_hamiltonian_infrastructure(j_max):
    """
    Constructs the time-independent components of the Hamiltonian.
    Returns:
        H_rot (Diagonal Matrix): Kinetic energy operator B*J*(J+1)
        H_int_coupling (Sparse Matrix): Coupling matrix <J|cos^2(theta)|J'>
        J_vals (Array): Array of rotational quantum numbers
    """
    # N2 is a homonuclear diatomic, so we consider only even J states (nuclear spin stats)
    # Selection rules for linear polarization: Delta J = 0, +/- 2
    j_vals = np.arange(0, 2 * j_max, 2)
    n_states = len(j_vals)

    # 1. Kinetic Energy (Field-Free Hamiltonian)
    # E_J = B * J * (J + 1)
    rot_energies = B_CONST * j_vals * (j_vals + 1)
    h_rot = np.diag(rot_energies)

    # 2. Interaction Coupling Matrix Elements <J|cos^2(theta)|J'>
    # Diagonal Elements <J|cos^2|J>
    # Formula: (2J^2 + 2J - 1) / ((2J - 1)(2J + 3))
    diag_elems = (2*j_vals**2 + 2*j_vals - 1) / ((2*j_vals - 1) * (2*j_vals + 3))

    # Off-Diagonal Elements <J|cos^2|J+2>
    off_diag_elems = np.zeros(n_states - 1)
    for i in range(n_states - 1):
        J = j_vals[i]
        # Clebsch-Gordan derived coupling strength
        val = np.sqrt(((J+1)*(J+2)) / ((2*J+1)*(2*J+3))) * \
              np.sqrt(((J+1)*(J+2)) / ((2*J+3)*(2*J+5)))
        off_diag_elems[i] = val

    # Assemble Tridiagonal Matrix
    h_coupling = np.diag(diag_elems) + \
                 np.diag(off_diag_elems, k=1) + \
                 np.diag(off_diag_elems, k=-1)

    return h_rot, h_coupling, j_vals, rot_energies

# Initialize System (Global Scope for Speed in ODE Solver)
H_ROT, COUPLING_MAT, J_VALUES, ROT_ENERGIES = build_hamiltonian_infrastructure(J_MAX)

def tdse_derivative(state_flat, t, amp, width, t0):
    """
    Computes the time derivative of the wavefunction for the ODE solver.
    d|Psi>/dt = -i/hbar * H(t) * |Psi>
    """
    # 1. Unpack State (Real -> Complex)
    n = len(state_flat) // 2
    psi = state_flat[:n] + 1j * state_flat[n:]

    # 2. Define Laser Field (Gaussian Envelope)
    # E(t)^2 ~ I(t)
    envelope = np.exp(-((t - t0)**2) / (2 * width**2))
    field_intensity = (amp * envelope)**2

    # 3. Construct Instantaneous Hamiltonian
    # H(t) = B*J^2 - 1/4 * DeltaAlpha * E(t)^2 * cos^2(theta)
    h_total = H_ROT - 0.25 * DELTA_ALPHA * field_intensity * COUPLING_MAT

    # 4. Schrödinger Equation
    # dPsi/dt = -i * H * Psi
    d_psi_dt = -1j / HBAR * h_total.dot(psi)

    # 5. Repack State (Complex -> Real)
    return np.concatenate([d_psi_dt.real, d_psi_dt.imag])

def run_experiment(amp, width, t_total=TIME_MAX, dt_steps=STEPS):
    """
    Simulates the laser-molecule interaction.
    Input: Laser Amplitude (a.u.), Pulse Width (a.u.)
    Output: Time grid, Alignment Trace <cos^2>, Final Population Distribution
    """
    t_grid = np.linspace(0, t_total, dt_steps)
    t_center = t_total / 2.0 # Center pulse in simulation window

    # Initial State: Ground State |J=0>
    psi_0 = np.zeros(len(J_VALUES), dtype=complex)
    psi_0[0] = 1.0 + 0j
    y0 = np.concatenate([psi_0.real, psi_0.imag])

    # Propagate Dynamics
    solution = odeint(tdse_derivative, y0, t_grid, args=(amp, width, t_center))

    # --- Post-Processing ---
    alignment_trace = []
    
    # Calculate expectation value <cos^2 theta> at each time step
    for step_state in solution:
        n = len(step_state) // 2
        psi_t = step_state[:n] + 1j * step_state[n:]
        
        # <Psi| Operator |Psi>
        exp_val = np.vdot(psi_t, COUPLING_MAT.dot(psi_t))
        alignment_trace.append(exp_val.real)

    # Final State Populations |c_J|^2
    final_state_flat = solution[-1]
    n = len(final_state_flat) // 2
    psi_final = final_state_flat[:n] + 1j * final_state_flat[n:]
    populations = np.abs(psi_final)**2

    return t_grid, np.array(alignment_trace), populations

# ==============================================================================
# SECTION 3: THE OPTIMIZATION ENGINE (GENETIC ALGORITHM)
# ==============================================================================

def fitness_function(params):
    """
    Cost Function: Maximizes Total Rotational Energy.
    Energy = Sum( P_J * E_J )
    """
    amp, width = params
    
    # Physical Constraints (prevent negative widths or unphysical amplitudes)
    if width <= 0.05 or amp < 0:
        return 0.0

    # Run Simulation (Only need final populations)
    _, _, final_pops = run_experiment(amp, width)
    
    # Calculate Fitness (Rotational Energy)
    rotational_energy = np.sum(final_pops * ROT_ENERGIES)
    return rotational_energy

def genetic_optimizer(generations=15, pop_size=20):
    """
    Evolutionary Strategy to find optimal pulse parameters.
    Gene: [Amplitude, Width]
    """
    print(f"\n--- INITIALIZING GENETIC ALGORITHM ---")
    print(f"Target: Maximize Rotational Energy Transfer")
    
    # 1. Initialize Population (Random Guess)
    # Amplitude [0, 25], Width [0.1, 2.0]
    population = np.random.rand(pop_size, 2)
    population[:, 0] *= 25.0 
    population[:, 1] = population[:, 1] * 1.9 + 0.1
    
    fitness_history = []
    best_gene_global = None
    best_fit_global = -1.0

    for gen in range(generations):
        # 2. Evaluate Fitness
        scores = np.array([fitness_function(ind) for ind in population])
        
        # 3. Elitism (Find Best)
        best_idx = np.argmax(scores)
        current_best_gene = population[best_idx]
        current_best_fit = scores[best_idx]
        
        if current_best_fit > best_fit_global:
            best_fit_global = current_best_fit
            best_gene_global = current_best_gene
            
        fitness_history.append(best_fit_global)
        
        # 4. Reproduction & Mutation
        new_pop = np.zeros_like(population)
        new_pop[0] = best_gene_global # Keep the king
        
        # Adaptive Mutation: Decays as generations progress
        noise_scale = 1.0 * (1 - gen / generations)
        
        # Generate offspring from best gene + Gaussian noise
        amp_noise = np.random.normal(0, 2.0 * noise_scale, pop_size - 1)
        width_noise = np.random.normal(0, 0.2 * noise_scale, pop_size - 1)
        
        new_pop[1:, 0] = best_gene_global[0] + amp_noise
        new_pop[1:, 1] = best_gene_global[1] + width_noise
        
        # Clip to physical boundaries
        new_pop[:, 1] = np.clip(new_pop[:, 1], 0.05, 3.0)
        new_pop[:, 0] = np.abs(new_pop[:, 0])
        
        population = new_pop
        
        print(f"Gen {gen+1:02d} | Best Energy: {current_best_fit:.4f} a.u. | "
              f"Pulse: Amp={current_best_gene[0]:.2f}, Width={current_best_gene[1]:.2f}")

    return best_gene_global, fitness_history

# ==============================================================================
# SECTION 4: MAIN EXECUTION & VISUALIZATION
# ==============================================================================

if __name__ == "__main__":
    
    # --- A. RUN OPTIMIZATION ---
    optimal_params, fit_hist = genetic_optimizer()
    opt_amp, opt_width = optimal_params
    
    print(f"\nOptimization Complete.")
    print(f"Optimal Parameters >> Amplitude: {opt_amp:.3f} | Width: {opt_width:.3f}")

    # --- B. RUN VALIDATION EXPERIMENTS ---
    
    # 1. Baseline (Manual Guess - Moderate pulse)
    base_amp, base_width = 5.0, 0.5
    t_base, align_base, pop_base = run_experiment(base_amp, base_width)
    
    # 2. Optimized (AI Discovered - Super-Rotor)
    t_opt, align_opt, pop_opt = run_experiment(opt_amp, opt_width)

    # --- C. PLOTTING RESULTS ---
    fig = plt.figure(figsize=(14, 8))
    
    # Subplot 1: Learning Curve
    ax1 = fig.add_subplot(2, 2, 1)
    ax1.plot(fit_hist, 'o-', color='green', lw=2)
    ax1.set_title("Genetic Algorithm Convergence")
    ax1.set_ylabel("Fitness (Rotational Energy)")
    ax1.set_xlabel("Generation")
    ax1.grid(True, alpha=0.3)

    # Subplot 2: Alignment Dynamics <cos^2 theta>
    ax2 = fig.add_subplot(2, 2, 2)
    ax2.plot(t_base, align_base, 'r--', label=f'Baseline (A={base_amp}, W={base_width})', alpha=0.7)
    ax2.plot(t_opt, align_opt, 'b-', label=f'Optimized (A={opt_amp:.1f}, W={opt_width:.1f})', lw=2)
    ax2.axhline(1/3, color='black', linestyle=':', label='Isotropic limit')
    ax2.set_title("Field-Free Molecular Alignment")
    ax2.set_ylabel(r"Alignment $\langle \cos^2 \theta \rangle$")
    ax2.set_xlabel("Time (a.u.)")
    ax2.legend()
    ax2.grid(True, alpha=0.3)

    # Subplot 3: Final Population Distribution (The "Super-Rotor" Signature)
    ax3 = fig.add_subplot(2, 1, 2)
    bar_width = 0.8
    ax3.bar(J_VALUES - bar_width/4, pop_base, width=bar_width/2, color='salmon', label='Baseline Population')
    ax3.bar(J_VALUES + bar_width/4, pop_opt, width=bar_width/2, color='navy', label='Optimized Population')
    ax3.set_title("Rotational State Distribution (Wavepacket Composition)")
    ax3.set_xlabel("Rotational Quantum Number J")
    ax3.set_ylabel("Population Probability")
    ax3.set_xticks(J_VALUES)
    ax3.legend()
    ax3.grid(True, axis='y', alpha=0.3)

    plt.tight_layout()
    plt.show()
