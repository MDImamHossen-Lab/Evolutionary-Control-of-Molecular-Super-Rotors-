"""
Scientifically Accurate Evolutionary Control of N2 Super-Rotors
Author: Research Group
Date: October 2023

Physics:
- Molecule: 14N2 (Linear Rigid Rotor + Centrifugal Distortion)
- Interaction: Non-resonant AC Stark Effect
- Units: Internal = Atomic Units (a.u.), Input/Output = SI/Spectroscopic
"""

import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import odeint

# ==============================================================================
# 1. SPECTROSCOPIC CONSTANTS & UNIT CONVERSIONS
# ==============================================================================

# Atomic Unit Conversions
AU_TO_CM = 219474.63       # 1 Hartree in cm^-1
AU_TO_FS = 0.0241888       # 1 a.u. time in femtoseconds
AU_TO_PS = 0.0000241888    # 1 a.u. time in picoseconds
AU_TO_TW_CM2 = 3.509e4     # 1 a.u. intensity in TW/cm^2

# Nitrogen (14N2) Parameters [Huber & Herzberg]
B0_CM = 1.989581           # Rotational constant (cm^-1)
D0_CM = 5.76e-6            # Centrifugal distortion (cm^-1)
DELTA_ALPHA_AU = 6.7       # Polarizability anisotropy (a.u.) ~ 1.0 A^3

# Convert to Atomic Units for Calculation
B0 = B0_CM / AU_TO_CM
D0 = D0_CM / AU_TO_CM

# Simulation Grid
J_MAX = 50                 # Basis size (High enough for T ~ 300K or Super-Rotors)
REVIVAL_TIME_AU = np.pi / B0
REVIVAL_TIME_PS = REVIVAL_TIME_AU * AU_TO_PS  # Approx 8.3 ps

print(f"--- SIMULATION PARAMETERS (14N2) ---")
print(f"Rotational Constant B0: {B0:.2e} a.u. ({B0_CM} cm^-1)")
print(f"Revival Time: {REVIVAL_TIME_PS:.2f} ps")
print(f"Basis Truncation: J_max = {J_MAX}")

# ==============================================================================
# 2. QUANTUM DYNAMICS ENGINE
# ==============================================================================

def build_hamiltonian_infrastructure():
    """
    Constructs static Hamiltonian matrices.
    Selection Rules: Delta J = 0, +/- 2
    """
    # Even J states only for 14N2 (Nuclear Spin I=1, Sigma_g+)
    # Technically odd J exist with different weights, but for alignment
    # starting from J=0, we stay in the even parity manifold.
    j_vals = np.arange(0, 2 * J_MAX, 2)
    n_states = len(j_vals)

    # 1. Field-Free Hamiltonian (Diagonal)
    # H_0 = B*J(J+1) - D*[J(J+1)]^2
    j_sq_term = j_vals * (j_vals + 1)
    energies = B0 * j_sq_term - D0 * (j_sq_term**2)
    h_rot = np.diag(energies)

    # 2. Interaction Coupling <J|cos^2|J'>
    # Diagonal
    diag = (2*j_vals**2 + 2*j_vals - 1) / ((2*j_vals - 1) * (2*j_vals + 3))

    # Off-Diagonal
    off_diag = np.zeros(n_states - 1)
    for i in range(n_states - 1):
        J = j_vals[i]
        val = np.sqrt(((J+1)*(J+2)) / ((2*J+1)*(2*J+3))) * \
              np.sqrt(((J+1)*(J+2)) / ((2*J+3)*(2*J+5)))
        off_diag[i] = val

    h_coupling = np.diag(diag) + np.diag(off_diag, k=1) + np.diag(off_diag, k=-1)

    return h_rot, h_coupling, j_vals, energies

# Initialize System
H_ROT, COUPLING_MAT, J_VALS, E_LEVELS = build_hamiltonian_infrastructure()

def tdse_derivative(state_flat, t, E0, tau, t_center):
    """
    Schrodinger Equation: i dPsi/dt = [H0 - 1/4 * DeltaAlpha * E(t)^2 * cos^2] Psi
    """
    # Unpack
    n = len(state_flat) // 2
    psi = state_flat[:n] + 1j * state_flat[n:]

    # Laser Field Envelope (Gaussian)
    # E(t) = E0 * exp(-2 ln2 * (t-tc)^2 / tau^2)  <-- FWHM definition
    # We use simple sigma definition for code speed: exp(-(t-tc)^2 / 2 sigma^2)
    # relation: sigma = tau / 2.3548
    sigma = tau / 2.3548

    if abs(t - t_center) < 4*sigma: # Optimization: Field is zero outside pulse
        field_sq = (E0 * np.exp(-((t - t_center)**2) / (2 * sigma**2)))**2
    else:
        field_sq = 0.0

    # Hamiltonian
    h_total = H_ROT - 0.25 * DELTA_ALPHA_AU * field_sq * COUPLING_MAT

    # Derivative
    dpsi = -1j * h_total.dot(psi)
    return np.concatenate([dpsi.real, dpsi.imag])

def run_experiment(intensity_tw, fwhm_fs, t_max_ps=2.0):
    """
    Runs the simulation.
    Inputs: Intensity (TW/cm2), FWHM (fs)
    """
    # Convert Inputs to Atomic Units
    intensity_au = intensity_tw / AU_TO_TW_CM2
    E0_au = np.sqrt(intensity_au) # Field Amplitude
    tau_au = fwhm_fs / AU_TO_FS
    t_max_au = t_max_ps / AU_TO_PS

    # Time Grid
    steps = 2000 # High res for pulse
    t_grid = np.linspace(0, t_max_au, steps)
    t_center = tau_au * 3.0 # Start pulse early

    # Initial State (Cold N2, J=0)
    psi0 = np.zeros(len(J_VALS), dtype=complex)
    psi0[0] = 1.0
    y0 = np.concatenate([psi0.real, psi0.imag])

    # Propagate
    sol = odeint(tdse_derivative, y0, t_grid, args=(E0_au, tau_au, t_center))

    # Calculate Alignment Trace
    trace = []
    for row in sol:
        n = len(row) // 2
        psi = row[:n] + 1j * row[n:]
        # <cos^2>
        val = np.vdot(psi, COUPLING_MAT.dot(psi)).real
        trace.append(val)

    # Final Populations
    final = sol[-1]
    psi_f = final[:n] + 1j * final[n:]
    pops = np.abs(psi_f)**2

    return t_grid * AU_TO_PS, np.array(trace), pops

# ==============================================================================
# 3. GENETIC ALGORITHM (OPTIMIZING REAL PARAMETERS)
# ==============================================================================

def fitness(params):
    # Params: [Intensity (TW), Duration (fs)]
    inten, dur = params

    # Constraints
    if inten > 100 or inten < 0: return 0 # Max 100 TW/cm2
    if dur < 10 or dur > 500: return 0    # 10fs to 500fs range

    # Run short sim (just enough to pass the pulse)
    _, _, pops = run_experiment(inten, dur, t_max_ps=0.5)

    # Fitness = Total Rotational Energy
    # Sum( P_J * E_J )
    energy = np.sum(pops * E_LEVELS)
    return energy * 1e4 # Scale up for readability

def run_ga():
    pop_size = 15
    generations = 10

    # Gene: [Intensity (0-60 TW), Duration (30-300 fs)]
    population = np.random.rand(pop_size, 2)
    population[:, 0] = population[:, 0] * 60.0
    population[:, 1] = population[:, 1] * 270.0 + 30.0

    history = []
    best_gene = None

    print("\n--- EVOLVING PULSE SHAPES ---")
    for gen in range(generations):
        scores = np.array([fitness(ind) for ind in population])
        best_idx = np.argmax(scores)
        best_gene = population[best_idx]
        history.append(scores[best_idx])

        print(f"Gen {gen+1}: Fit={scores[best_idx]:.2f} | I={best_gene[0]:.1f} TW/cm2, t={best_gene[1]:.1f} fs")

        # Elitism + Mutation
        new_pop = np.zeros_like(population)
        new_pop[0] = best_gene

        noise_scale = 1.0 * (1 - gen/generations)
        noise_I = np.random.normal(0, 5.0 * noise_scale, pop_size-1)
        noise_t = np.random.normal(0, 10.0 * noise_scale, pop_size-1)

        new_pop[1:, 0] = np.abs(best_gene[0] + noise_I)
        new_pop[1:, 1] = np.abs(best_gene[1] + noise_t)
        population = new_pop

    return best_gene, history

# ==============================================================================
# 4. EXECUTION AND PLOTTING
# ==============================================================================

if __name__ == "__main__":
    # 1. Run Optimization
    opt_params, learn_curve = run_ga()

    # 2. Run High-Res Simulations for Plots (Longer time for revivals)
    # Baseline: 10 TW/cm2, 200 fs (Standard alignment pulse)
    t_base, align_base, pop_base = run_experiment(10.0, 200.0, t_max_ps=10.0)

    # Optimized: Result from GA
    t_opt, align_opt, pop_opt = run_experiment(opt_params[0], opt_params[1], t_max_ps=10.0)

    # --- SAVE PLOTS FOR LATEX ---

    # Fig 1: Baseline Trace
    plt.figure(figsize=(6, 4))
    plt.plot(t_base, align_base, 'r', label='Baseline')
    plt.xlabel('Time (ps)')
    plt.ylabel(r'$\langle \cos^2 \theta \rangle$')
    plt.title('Baseline Alignment (10 TW, 200 fs)')
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.savefig('fig1_baseline_trace.png', dpi=300)

    # Fig 2: Baseline Pop
    plt.figure(figsize=(6, 4))
