    plt.xlabel('J State')
    plt.ylabel('Population')
    plt.title('Baseline Populations')
    plt.tight_layout()
    plt.savefig('fig2_baseline_pop.png', dpi=300)

    # Fig 3: Learning Curve
    plt.figure(figsize=(6, 4))
    plt.plot(range(1, len(learn_curve)+1), learn_curve, 'g-o')
    plt.xlabel('Generation')
    plt.ylabel('Rotational Energy Score')
    plt.title('Evolutionary Learning')
    plt.grid(True)
    plt.tight_layout()
    plt.savefig('fig3_learning.png', dpi=300)

    # Fig 4: Results Comparison
    plt.figure(figsize=(10, 5))
    plt.subplot(1, 2, 1)
    plt.plot(t_opt, align_opt, 'b', label='Optimized')
    plt.plot(t_base, align_base, 'r--', alpha=0.5, label='Baseline')
    plt.xlabel('Time (ps)')
    plt.legend()
    plt.title('Revival Dynamics')

    plt.subplot(1, 2, 2)
    plt.bar(J_VALS+0.5, pop_opt, width=1.8, color='blue', label='Optimized')
    plt.bar(J_VALS-0.5, pop_base, width=1.8, color='red', alpha=0.5, label='Baseline')
    plt.xlabel('J State')
    plt.legend()
    plt.title('Super-Rotor Distribution')
    plt.tight_layout()
    plt.savefig('fig4_results.png', dpi=300)

    print("All images generated.")
